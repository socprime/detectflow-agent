# =============================================================================
# DetectFlow agent-job — K8s Operator image (Apache Flink base)
# =============================================================================
#
# Runs `python -m app.jobs.agent`. Thread mode (Pemja); never share a TaskManager with process-mode jobs.
#
# Dependencies: [agent] extra = apache-flink + flink-agents (~400 MB wheel
# from PyPI) + openai. Pemja builds from source on install — needs JDK
# headers under JAVA_HOME/include (the Flink base image ships only a JRE
# there, so we symlink the apt-installed JDK include/ tree in).
#
# Build (no build args — all dependencies resolve from public indexes per
# uv.lock, incl. the flink-agents wheel):
#   docker build -f Dockerfile.agent -t detectflow-agent-agent:dev .
# =============================================================================

FROM flink:2.2.0-scala_2.12-java11

USER root

# Python 3.11 from the deadsnakes PPA (flink:2.2.0 base default is too new
# on bookworm and not resolvable via apt-pinned `python3.11` directly).
# Pemja's setup.py looks for JDK headers under $JAVA_HOME/include; the
# Flink base image ships only a JRE there — symlink the apt-installed
# JDK include/ tree so the build finds jni.h.
RUN set -ex; apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates curl gpg gpg-agent && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-11-jdk-headless \
        python3.11 python3.11-venv python3.11-dev \
        python3-pip libpython3.11 \
        gcc g++ && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python3 && \
    ln -sf /usr/lib/jvm/java-11-openjdk-*/include /opt/java/openjdk/include && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(dpkg --print-architecture) && \
    ln -sf /usr/lib/jvm/java-11-openjdk-${ARCH} /usr/lib/jvm/java-11
ENV JAVA_HOME=/usr/lib/jvm/java-11

# uv — project's package manager.
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/

WORKDIR /opt/flink/usrlib

# Copy lock + manifest first for layer caching.
COPY pyproject.toml uv.lock ./

# Copy app source (needed for hatchling install discovery).
COPY app /opt/flink/usrlib/app

# Install into an isolated .venv (see Dockerfile.correlation rationale).
# `agent` extra brings apache-flink + flink-agents + openai.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra agent

# Drop build deps. Pemja's C extension is already compiled and installed
# inside the venv, so toolchain isn't needed at runtime.
RUN apt-get purge -y --auto-remove gcc g++ python3.11-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Surface the venv on PATH so `python -m app.jobs.agent` resolves.
ENV PATH="/opt/flink/usrlib/.venv/bin:$PATH"

# Kafka connector → Flink classpath.
# zstd-jni provides the native zstd codec the Kafka client lazy-loads when
# compression.type=zstd; the connector jar above does not bundle it.
COPY lib/flink-sql-connector-kafka-4.0.1-2.0.jar /opt/flink/lib/
COPY lib/zstd-jni-1.5.6-6.jar /opt/flink/lib/

# Logging config.
COPY log4j2.properties /opt/flink/usrlib/log4j2.properties

# Filesystem prep.
RUN mkdir -p /opt/flink/checkpoints /opt/flink/log /opt/flink/usrlib/logs && \
    chown -R flink:flink /opt/flink/checkpoints /opt/flink/log /opt/flink/usrlib

ENV PYTHONPATH="/opt/flink/usrlib:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1
# Force UTC so timestamps are host-TZ-independent (parity with correlation).
ENV TZ=UTC

USER flink
WORKDIR /opt/flink

EXPOSE 8081 6123

# K8s Operator drives the entrypoint via PythonDriver — no CMD/ENTRYPOINT.
