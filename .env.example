# ==========================================================================
# DetectFlow Agent — environment template
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# All settings are documented in app/config/settings.py.
# ==========================================================================

# --------------------------------------------------------------------------
# KAFKA — connection
# --------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Auth method: SASL | SSL | PLAINTEXT
# Template defaults to PLAINTEXT so `cp .env.example .env` yields a
# Settings()-loadable config without additional secrets. Switch to SASL
# (with KAFKA_API_KEY/KAFKA_API_SECRET) for Confluent Cloud or any SASL_SSL cluster.
KAFKA_AUTH_METHOD=PLAINTEXT

# SASL (required when KAFKA_AUTH_METHOD=SASL)
# KAFKA_API_KEY=
# KAFKA_API_SECRET=

# SSL (required when KAFKA_AUTH_METHOD=SSL)
# KAFKA_SSL_CA_LOCATION=/path/to/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/path/to/client.pem
# KAFKA_SSL_KEY_LOCATION=/path/to/client.key
# KAFKA_SSL_KEY_PASSWORD=
# KAFKA_SSL_TRUSTSTORE_LOCATION=
# KAFKA_SSL_TRUSTSTORE_PASSWORD=
# KAFKA_SSL_CHECK_HOSTNAME=true

# --------------------------------------------------------------------------
# KAFKA — topics
# --------------------------------------------------------------------------
# Correlation-job input (tagged-events tech topic, comma-separated supported)
KAFKA_INPUT_TOPICS=detectflow.tagged-events

# Attack Chains meta + data topics (these are the defaults)
KAFKA_ACTIVE_THREATS_TOPIC=detectflow.active-threats
KAFKA_HOS_RULES_TOPIC=detectflow.hos-rules
KAFKA_CHAINS_CONFIG_TOPIC=detectflow.chains-config
KAFKA_CHAINS_RAW_TOPIC=detectflow.chains-raw
KAFKA_CHAINS_ANALYSED_TOPIC=detectflow.chains-analysed

# --------------------------------------------------------------------------
# KAFKA — consumer
# --------------------------------------------------------------------------
KAFKA_CONSUMER_GROUP=flink-agent
# earliest | latest | committed (committed offsets with EARLIEST fallback on
# a group with no committed position). Group ids are scoped by JOB_ID.
KAFKA_STARTING_OFFSET=latest

# --------------------------------------------------------------------------
# ATTACK CHAINS — defaults (overridable via chains-config broadcast)
# --------------------------------------------------------------------------
CHAIN_COVERAGE_THRESHOLD_PCT=60
# Unused fallback: every HoS rule defines detection.timeframe.
# CHAIN_DEFAULT_WINDOW_SECONDS=300
# CHAIN_ID_NAMESPACE=6ba7b810-9dad-11d1-80b4-00c04fd430c8
# Grace before the matcher's processing-time timer GCs a closed buffer from
# keyed state. Must be >= source out-of-orderness (60s). Bounds the otherwise-
# unbounded (hos_id, hostname, window) keyed state (the event-time cleanup
# timer never fires behind the Long.MIN watermark).
CHAIN_BUFFER_CLEANUP_GRACE_SECONDS=120
# Min seconds between re-emits of the same chain after the threshold is
# crossed (0 disables). The first threshold-crossing emit is never delayed;
# suppressed changes are flushed as a final revision by the window-cleanup
# timer, so the last revision always reflects the complete buffer.
# CHAIN_REEMIT_DEBOUNCE_SECONDS=30

# --------------------------------------------------------------------------
# MULTI-TENANCY
# --------------------------------------------------------------------------
# Distinct per deployment: scopes Kafka consumer groups and EOS transactional-id
# prefixes, and names the Flink job. MUST be an env var — workers rebuild
# Settings() from the environment, so --job-id alone never reaches them.
JOB_ID=local
# Correlation-pipeline identity (identity only, never routing). Unset = the
# legacy single-instance deployment. This is the BARE UUID of
# correlation_pipelines.id — JOB_ID above is the deployment name and is a
# different value; never set one from the other.
# CORRELATION_PIPELINE_ID=
# CORRELATION_PIPELINE_NAME=
# ALLOW_DEFAULT_JOB_ID=false

# --------------------------------------------------------------------------
# FLINK
# --------------------------------------------------------------------------
# Keep 1 for correlation-job: >1 can loop its cold start (see settings.py).
FLINK_PARALLELISM=1
FLINK_CHECKPOINT_INTERVAL_MS=60000
# 15 min: sized for the correlation-job cold start (full meta-topic replay must
# finish before the first checkpoint barrier passes). A 5-min timeout expires
# mid-replay and, with tolerable-failed-checkpoints=0, loops the job into a
# fresh cold replay forever. See app/config/settings.py for the full rationale.
FLINK_CHECKPOINT_TIMEOUT_MS=900000
FLINK_MIN_PAUSE_BETWEEN_CHECKPOINTS_MS=30000
# Agent-job checkpoint timeout — it has no cold-start replay, so 3 min is
# plenty. It must stay below FLINK_TRANSACTION_TIMEOUT_MS if chains-analysed
# is ever switched to EXACTLY_ONCE (both sinks are AT_LEAST_ONCE today).
AGENT_CHECKPOINT_TIMEOUT_MS=180000
# EXACTLY_ONCE producer transaction.timeout.ms (unused while both sinks are
# AT_LEAST_ONCE) — MUST exceed
# AGENT_CHECKPOINT_TIMEOUT_MS; capped at/below the broker's
# transaction.max.timeout.ms (Kafka 4.x default = 15 min).
FLINK_TRANSACTION_TIMEOUT_MS=600000

# --------------------------------------------------------------------------
# STATE BACKEND & CHECKPOINTS
# --------------------------------------------------------------------------
STATE_BACKEND=rocksdb
CHECKPOINT_PATH=file:///opt/flink/checkpoints

# RocksDB tuning
ROCKSDB_WRITEBUFFER_SIZE_MB=64
ROCKSDB_WRITEBUFFER_COUNT=3
ROCKSDB_BLOCK_CACHE_SIZE_MB=256
ROCKSDB_BLOCK_SIZE_KB=4
ROCKSDB_COMPACTION_STYLE=LEVEL
ROCKSDB_THREAD_NUM=4

# --------------------------------------------------------------------------
# LLM (OpenAI-compatible endpoint — agent-job only)
# Defaults below point at a local Ollama; override in .env for any other
# OpenAI-compatible backend (vLLM, OpenAI, Anthropic, …). vLLM-style
# endpoints don't validate API keys — any non-empty string works.
# --------------------------------------------------------------------------
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_MAX_TOKENS=2048
# Advisory only — not enforced.
LLM_PROMPT_CHAR_BUDGET=24000
# GLOBAL per-job call budget — split across parallel subtasks (budget //
# FLINK_PARALLELISM, floor 1) so the aggregate rate stays ≈ this value.
LLM_CALLS_PER_MINUTE=60
# Max seconds to block waiting for a token-bucket permit before taking the
# throttled (null-verdict) degradation path; 0 = never wait. A bounded wait
# converts short bursts into Flink backpressure instead of lost analyses.
# Keep worst-case per-record wall time well below AGENT_CHECKPOINT_TIMEOUT_MS.
# LLM_THROTTLE_MAX_WAIT_SECONDS=10.0
LLM_MAX_RETRIES=3
# Per-attempt request timeout (seconds). Bounds operator stall on a hung LLM
# endpoint so the call cannot block the task thread / checkpoint barrier for
# the SDK default 600s. Keep worst-case (timeout × (retries+1) + backoff) well
# below AGENT_CHECKPOINT_TIMEOUT_MS.
LLM_REQUEST_TIMEOUT_SECONDS=30
# HTTPS endpoint with a self-signed / private-CA certificate: point the standard
# SSL_CERT_FILE at a PEM bundle holding that CA — httpx (openai SDK) honours it.
# The certificate must carry a SAN for the host/IP in LLM_BASE_URL; Python
# ignores CN. In Kubernetes the bundle is mounted by detectflow-backend.
# SSL_CERT_FILE=/etc/ssl/agent-ca/ca.pem
# Escape hatch when the certificate cannot be fixed — accepts ANY certificate on
# the LLM leg (test only; prefer SSL_CERT_FILE above).
# LLM_SSL_VERIFY=false

# --------------------------------------------------------------------------
# LOGGING
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
